{
  "name": "llm-protocol",
  "version": "1.0.2",
  "description": "Clean-room LLM protocol translation core: Anthropic Messages <-> OpenAI Chat",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "llm",
    "protocol",
    "translation",
    "anthropic",
    "openai",
    "messages",
    "chat-completions",
    "sse",
    "streaming"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geebos/llm-protocol.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:all": "tsc --noEmit -p tsconfig.full.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "compat": "tsx apps/compat-runner/cli.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "dotenv": "^17.4.2",
    "openai": "^7.4.0",
    "tsx": "^4.23.9",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
