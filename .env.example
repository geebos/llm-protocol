# llm-protocol 兼容性测试环境变量示例
# 复制为 .env 后填写（.env 已被 git 忽略，不会提交）

# ---- Anthropic 原生 ----
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_TEST_MODEL=claude-sonnet-4-5

# ---- OpenAI 原生 ----
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=sk-proj-xxx
OPENAI_TEST_MODEL=gpt-4o-mini

# ---- 第三方 OpenAI-compatible（必填 baseUrl 与 model）----
COMPAT_A_BASE_URL=https://your-gateway.example.com/v1
COMPAT_A_API_KEY=sk-xxx
COMPAT_A_MODEL=your-model
